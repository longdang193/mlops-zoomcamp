# Azure Machine Learning Configuration Template
# Copy this file to .env and fill in your values:
#   cp env.template .env
#   Then edit .env with your actual values

# Azure ML Workspace Configuration
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=rg-azureml-mlflow
AZURE_WORKSPACE_NAME=aml-mlflow-xxxxx

# Authentication (choose one):
# Option 1: Use DefaultAzureCredential (recommended for local development)
#   - Automatically uses: Azure CLI, Managed Identity, or Environment variables
#   - Just run: az login
#   - No additional configuration needed

# Option 2: Use Service Principal (for CI/CD or automation)
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret
# AZURE_TENANT_ID=your_tenant_id


