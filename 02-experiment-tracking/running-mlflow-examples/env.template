# MLflow Azure Configuration Template
# Copy this file to .env and fill in your values:
#   cp env.template .env
#   Then edit .env with your actual values

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://your_vm_ip:5000

# Azure Storage Configuration (for artifact storage)
# Fill in these two fields - the connection string will be built automatically
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_KEY=your_storage_account_key

# Alternative: Use connection string directly (instead of the fields above)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# PostgreSQL Configuration (optional - if needed for direct DB access)
# POSTGRES_HOST=pg-mlflow-xxxxx.postgres.database.azure.com
# POSTGRES_USER=mlflow
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=mlflow

# Azure Resource Group (for reference)
# RESOURCE_GROUP=rg-mlflow-blob

# Storage Account Name (for reference)
# STORAGE_ACCOUNT_NAME=stmlflowxxxxx

# Blob Container Name
# CONTAINER_NAME=mlflow-artifacts

